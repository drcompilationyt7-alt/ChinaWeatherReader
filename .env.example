# =============================================================================
# Mr. WorldWideWebster - Environment Configuration
# =============================================================================
# All of these values should be stored in GitHub Secrets:
#   Settings → Secrets and variables → Actions
# The .env file is for local testing only.
# =============================================================================

# ═══════════════════════════════════════════════════════════════
#  HERMES AGENT — OLLAMA (Local Model for Web Research)
# ═══════════════════════════════════════════════════════════════
# Hermes CLI uses Ollama for web browsing and trend research
# Install Ollama: https://ollama.ai/
# Pull a model: ollama pull qwen2.5:7b

# Ollama host URL (default is local)
OLLAMA_HOST=http://localhost:11434

# Model for Hermes web research
OLLAMA_MODEL=qwen2.5:7b

# Optional: Override specifically for Hermes agent
HERMES_OLLAMA_MODEL=qwen2.5:7b

# ═══════════════════════════════════════════════════════════════
#  OPENROUTER — Analysis, Scripts, Explain Pipeline
# ═══════════════════════════════════════════════════════════════
# OpenRouter is used for: script writing, analysis, explainers
# Sign up: https://openrouter.ai/ — then generate a key
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# MULTI-KEY ROTATION: Add up to 7 additional OpenRouter API keys (keys 2-8).
# The provider auto-rotates through keys when one hits rate/credit limits.
# Set these as GitHub Secrets:
# OPENROUTER_API_KEY_2=sk-or-your-second-key-here
# OPENROUTER_API_KEY_3=sk-or-your-third-key-here
# OPENROUTER_API_KEY_4=sk-or-your-fourth-key-here
# OPENROUTER_API_KEY_5=sk-or-your-fifth-key-here
# OPENROUTER_API_KEY_6=sk-or-your-sixth-key-here
# OPENROUTER_API_KEY_7=sk-or-your-seventh-key-here
# OPENROUTER_API_KEY_8=sk-or-your-eighth-key-here

# Models to use on OpenRouter (you can change these anytime)
# openrouter/owl-alpha is currently FREE — great for all text/thinking tasks
OPENROUTER_DEFAULT_MODEL=openrouter/owl-alpha
OPENROUTER_SCRIPT_MODEL=openrouter/owl-alpha
OPENROUTER_AGENT_MODEL=openrouter/owl-alpha
# For AI image generation (used in slideshow/thumbnail creation)
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-schnell

# Option B: OpenAI (fallback if no OpenRouter key set)
# Get it from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# YouTube Data API Key (Required - for uploading & managing channel)
# Get it from: https://console.cloud.google.com/ (YouTube Data API v3)
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
# Run `node youtube-automation/setup-youtube.js` locally to generate this:
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token-here

# --- CHANNEL INFO ---

CHANNEL_NAME=Mr. WorldWideWebster
CHANNEL_TAGLINE=Bringing the world to you
TARGET_AUDIENCE=Global culture enthusiasts, travelers, people curious about international trends

# --- AI PROVIDER CONFIG ---

# Primary AI Provider: openai or gemini
AI_PROVIDER=openai

# OpenAI Models (adjust based on your budget)
OPENAI_MODEL=gpt-4o-mini
OPENAI_SCRIPT_MODEL=gpt-4o

# Gemini (free alternative - uncomment to use instead of OpenAI)
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

# --- TTS (Text-to-Speech) — FREE options ---

# Options: edge (free, recommended), openai (paid), elevenlabs (paid)
# "edge" uses Microsoft Edge-TTS — $0, no API key needed, supports 100+ languages
TTS_PROVIDER=edge

# Edge-TTS Voices (pick from list: https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support)
# en-US-AvaMultilingualNeural is cute, soft, younger-sounding, very natural
EDGE_TTS_VOICE_CURIOUS=en-US-AvaMultilingualNeural
EDGE_TTS_VOICE_EXPLAINER=en-US-GuyNeural
EDGE_TTS_VOICE_NEWS=en-GB-SoniaNeural

# ElevenLabs (higher quality, multilingual support)
# Get it from: https://elevenlabs.io/
# ELEVENLABS_API_KEY=your-elevenlabs-key-here
# ELEVENLABS_VOICE_CURIOUS=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_EXPLAINER=TxGEqnHWrfWFTfGW9XjX

# --- CONTENT SOURCING ---

# Which platforms to source from (comma-separated)
# Options: bilibili, douyin, rednote, tiktok, twitter, news
ENABLED_SOURCES=bilibili, tiktok, news

# Sourcing schedule (cron expression)
SOURCE_SCHEDULE=0 */6 * * *

# --- YOUTUBE UPLOAD SETTINGS ---

YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=public  # public, unlisted, private
POSTING_FREQUENCY=daily
MAX_UPLOADS_PER_DAY=5

# --- OUTPUT SETTINGS ---

OUTPUT_DIR=./output
LOCAL_WHISPER_MODEL=base  # tiny, base, small, medium, large-v3

# --- DISCORD NOTIFICATIONS ---
# Get your bot token from: https://discord.com/developers/applications
# Create a new application → Bot → Copy token
# Store this in GitHub Secrets: DISCORD_BOT_TOKEN
# DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Optional: Specific channel ID to post in (leave blank for auto-detect)
# Find channel ID: Discord → Settings → Advanced → Developer Mode → Right-click channel → Copy ID
# DISCORD_CHANNEL_ID=123456789012345678

# --- VIEW BOOST SETTINGS (GitHub Actions only) ---
# Controls the Puppeteer-based view booster that runs after uploads
BOOST_ENABLED=true               # Enable/disable view boosting
BOOST_MAX_VIEWS=100              # Max views per video (10-200)
BOOST_MIN_VIEWS=50               # Min views per video
BOOST_MIN_WATCH_SEC=30           # Min seconds per view session
BOOST_MAX_WATCH_SEC=90           # Max seconds per view session
BOOST_SPREAD_MIN=15              # Min minutes to spread views over
BOOST_SPREAD_MAX=45              # Max minutes to spread views over

# --- OPTIONAL: MuAPI (faster clipping pipeline) ---
# MUAPI_API_KEY=your-muapi-key-here

# --- OPTIONAL: Replicate (for advanced video generation) ---
# REPLICATE_API_KEY=your-replicate-key-here