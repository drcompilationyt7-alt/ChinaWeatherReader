    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "winston": "^3.11.0",
    "sqlite3": "^5.1.6",
    "googleapis": "^128.0.0",
    "youtube-dl-exec": "^3.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "ffmpeg-static": "^5.2.0",
    "puppeteer": "^22.0.0",
    "@google/genai": "^1.0.0",
    "discord.js": "^14.14.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}