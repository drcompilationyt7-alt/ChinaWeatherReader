{
  "name": "mr-worldwidewebster",
  "version": "1.0.0",
  "description": "AI YouTube Channel - Bringing the world to you. Global content sourcing, clipping, translation, and AI creation.",
  "main": "core/index.js",
  "scripts": {
    "start": "node core/index.js",
    "setup": "node scripts/setup.js",
    "dashboard": "node dashboard/server.js",
