    "test": "node scripts/test.js",
    "setup-youtube": "node youtube-automation/setup-youtube.js",
    "boost": "node boost/boost-engine.js --url <video-url> --views 100",
    "discord-test": "node discord/discord-bridge.js --test"
  },
  "dependencies": {
    "openai": "^4.20.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
